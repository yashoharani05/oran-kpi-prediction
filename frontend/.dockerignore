# frontend/.dockerignore
#
# Files not copied into the Docker image.

# Dependencies — reinstalled fresh inside Docker
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output — rebuilt inside Docker
.next/
out/

# Environment files (sensitive — never bake into images)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Git
.git/
.gitignore

# Documentation
*.md
README*
