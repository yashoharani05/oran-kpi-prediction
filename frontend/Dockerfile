# =============================================================================
# frontend/Dockerfile
#
# Builds the Next.js frontend into a Docker image using a two-stage build.
#
# WHY TWO STAGES?
#   Stage 1 (builder): Install ALL dependencies and build the app.
#                      This includes devDependencies like TypeScript.
#   Stage 2 (runner):  Copy only the built output into a fresh, clean image.
#                      The final image does not contain node_modules, TypeScript,
#                      or any build tools — just the compiled app.
#
#   Result: the production image is ~300 MB smaller than a single-stage build.
# =============================================================================

# -----------------------------------------------------------------------
# STAGE 1: builder
# -----------------------------------------------------------------------
FROM node:18-alpine AS builder

# node:18-alpine uses Alpine Linux — a tiny Linux distro (~5 MB).
# Much smaller than node:18 (which uses Debian).

WORKDIR /app

# Copy package files first for Docker layer caching.
# If package.json hasn't changed, npm install is skipped in rebuilds.
COPY package.json package-lock.json* ./

# Install all dependencies (including devDependencies needed for build).
# --frozen-lockfile ensures the exact versions in package-lock.json are used.
RUN npm install --frozen-lockfile

# Copy the rest of the source code.
COPY . .

# Build the production Next.js app.
# This compiles TypeScript, bundles JavaScript, and optimises images.
# Output goes into the .next/ folder.
RUN npm run build

# -----------------------------------------------------------------------
# STAGE 2: runner (the final image)
# -----------------------------------------------------------------------
FROM node:18-alpine AS runner

WORKDIR /app

# Set NODE_ENV to production.
# This tells Next.js to run in production mode (faster, no hot reload).
ENV NODE_ENV=production

# Set the backend URL for the API proxy inside the container.
# In Docker, services talk to each other by service name (defined in docker-compose.yml).
# "backend" is the name of the FastAPI service — Next.js proxies /api/* to it.
ENV NEXT_PUBLIC_BACKEND_URL=http://backend:8000

# Copy only what Next.js needs to run in production from the builder stage:
# - package.json: needed by npm start
# - .next/standalone: the self-contained production server (enabled by output: 'standalone')
# - .next/static: compiled CSS, JS, and other static assets
# - public/: any static files in the public/ folder
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Expose port 3000 (Next.js default).
EXPOSE 3000

# Start the Next.js production server.
# server.js is generated by the standalone output mode.
CMD ["node", "server.js"]
