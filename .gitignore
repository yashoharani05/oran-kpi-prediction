# ============================================================
# .gitignore — Files that should NOT be committed to Git
# ============================================================

# --- Python ---
venv/                    # Virtual environment (recreated with pip install)
__pycache__/             # Python bytecode cache
*.pyc
*.pyo
*.pyd
.Python

# --- ML model files (large binary files) ---
# These are saved locally but should not be in Git
# (They are generated by running the training scripts)
# backend/models/*.pkl
# backend/models/*.h5
# backend/models/*.json
backend/venv/

# --- Data files ---
# The raw CSV may be large or confidential
backend/data/raw/*.csv
backend/data/processed/*.csv
data/raw/*.csv

# --- Node.js ---
node_modules/
frontend/node_modules/   # Dependencies (recreated with npm install)
.next/
frontend/.next/          # Next.js build output
frontend/out/            # Static export output

# --- Environment variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- OS files ---
.DS_Store                # macOS
Thumbs.db                # Windows
desktop.ini

# --- Editor files ---
.vscode/settings.json
.idea/
*.swp
*.swo
